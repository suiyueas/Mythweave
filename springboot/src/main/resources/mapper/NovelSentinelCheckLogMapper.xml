<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novelcraft.web.mapper.NovelSentinelCheckLogMapper">

    <!-- ==================== 智能哨兵巡检日志查询 ==================== -->

    <!--
        功能: 查询最近的哨兵巡检日志
        参数: projectId - 项目ID, limit - 返回记录数
        返回: List<NovelSentinelCheckLog> 巡检日志列表
        说明: 按开始时间倒序，用于展示巡检历史记录
    -->
    <select id="selectRecent" resultType="com.novelcraft.web.entity.NovelSentinelCheckLog">
        SELECT * FROM novel_sentinel_check_log
        WHERE project_id = #{projectId} AND deleted = 0
        ORDER BY started_at DESC
        LIMIT #{limit}
    </select>

    <!--
        功能: 统计正在运行的巡检任务数
        参数: projectId - 项目ID
        返回: int 运行中的巡检任务数量
        说明: 用于防止并发巡检，保证同一时间只有一个巡检任务运行
    -->
    <select id="countRunning" resultType="int">
        SELECT COUNT(*) FROM novel_sentinel_check_log
        WHERE project_id = #{projectId} AND status = 'running' AND deleted = 0
    </select>

</mapper>