# ================================================
# 数据库配置 (MySQL)
# ================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mythweave
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# ================================================
# Redis 配置
# ================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# ================================================
# Elasticsearch 配置
# ================================================
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=your_elastic_username
ES_PASSWORD=your_elastic_password

# ================================================
# 应用配置
# ================================================
SERVER_PORT=8080

# JWT 密钥（请使用 256 位随机字符串）
JWT_SECRET=your-256-bit-secret-key-here

# 头像上传路径（相对路径更利于部署）
AVATAR_UPLOAD_PATH=./uploads/avatar

# ================================================
# AI 服务配置
# ================================================
# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 思考模式（V4 thinking.type）：enabled=思考（默认）/ disabled=非思考
DEEPSEEK_THINKING=enabled
# 思考强度：low/high/max（仅思考模式生效，长文生成建议 low/high 留预算给正文）
DEEPSEEK_REASONING_EFFORT=high
# 思考模式调用失败时自动降级为非思考模式重试一次（true/false）
DEEPSEEK_DEGRADE_ON_FAILURE=true
DEEPSEEK_MAX_TOKEN=4096
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.9

# 千问 Embedding API (阿里云百炼)
# 注意：变量名与后端配置 ${QIANWEN_API_KEY} / Compose 注入保持一致，勿写成 QW_API_KEY
QIANWEN_API_KEY=your_qianwen_api_key
QW_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QW_EMBEDDING_ENDPOINT=/service/embeddings/text-embedding/text-embedding
QW_EMBEDDING_MODEL=text-embedding-v3
QW_EMBEDDING_DIMENSIONS=1024