# ========================================================
# Docker Compose 部署环境变量模板
# 使用：Copy-Item .env.docker.example .env
# 所有必填项均为占位符，请替换为真实值后再执行 docker compose up
# ========================================================

# ============ 基础设施 ============
# MySQL root 密码（后端使用 root 账号连接）
DB_PASSWORD=your_mysql_password
# 主机端口映射（容器内固定 3306）
DB_PORT=3306
DB_NAME=mythweave

# Redis 密码
REDIS_PASSWORD=your_redis_password
# 主机端口映射（容器内固定 6379）
REDIS_PORT=6379

# Elasticsearch elastic 用户密码（后端使用 elastic 账号连接）
ES_PASSWORD=your_elastic_password
# 主机端口映射（容器内固定 9200）
ES_PORT=9200
# Elasticsearch 镜像与 IK 插件版本（需匹配后端 Java Client 8.18 系列）
ES_VERSION=8.18.8

# ============ 应用 ============
# 后端端口映射（容器内固定 8080）
SERVER_PORT=8080
# 前端端口映射（容器内固定 80）
FRONTEND_PORT=80

# JWT 签名密钥（建议 64 位随机字符串）
JWT_SECRET=your-256-bit-secret-key-here

# ============ AI 服务（至少配置 DeepSeek，千问 Embedding 用于 RAG 向量检索） ============
DEEPSEEK_API_KEY=your_deepseek_api_key
# 可选
MIMO_API_KEY=
QIANWEN_API_KEY=your_qianwen_api_key
